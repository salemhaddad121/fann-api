# -----------------------------------------------
# Fann API — environment variables
# Copy to .env and fill in values before running
# -----------------------------------------------

# App
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
# Hosted Postgres (Neon, Supabase, RDS) publishes one connection string and
# requires TLS. Set DATABASE_URL and the discrete DB_* vars below are
# ignored; sslmode is honoured from the URL.
#   DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL=
# Only needed when a TLS host is addressed by discrete parts instead.
DB_SSL=false
# Serverless wants DB_POOL_MIN=0 — each function instance holds its own
# pool, so a floor of 2 burns a managed provider's connection cap idling.
DB_POOL_MIN=2
DB_POOL_MAX=10

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fann
DB_USER=postgres
DB_PASSWORD=

# Redis
# Hosted Redis (Upstash, Redis Cloud) publishes one connection string and
# requires TLS. Set REDIS_URL and the discrete vars below are ignored.
#   REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# REDIS_TLS=true is only needed if a host requires TLS but publishes a
# plain redis:// URL; rediss:// already implies it.
REDIS_URL=
REDIS_TLS=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Apple OAuth
APPLE_CLIENT_ID=        # Your Services ID (e.g. com.yourapp.service)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=      # Contents of your .p8 key file (newlines as \n)
APPLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/apple/callback

# WhatsApp Business Cloud API (Meta) — OTP delivery
# 1. Create a Meta developer app + WhatsApp product: https://developers.facebook.com/apps
# 2. WHATSAPP_PHONE_NUMBER_ID comes from WhatsApp > API Setup in that app
# 3. WHATSAPP_ACCESS_TOKEN — use a permanent System User token for production
#    (the default 24h token from API Setup is fine for local testing only)
# 4. Create + get Meta approval for an "authentication" message template
#    (Business Manager > Account Tools > Message Templates) before this works —
#    business-initiated messages require an approved template, plain text won't send.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v20.0

# Email (Resend) — used by EmailService for verification + review-request emails.
# Get an API key at https://resend.com. Without it, EmailService logs instead
# of sending (safe for local dev, but nothing will actually arrive).
RESEND_API_KEY=
EMAIL_FROM=noreply@fann.app

# Object storage (S3-compatible) — media uploads
# Works with AWS S3 or any S3-compatible provider (Cloudflare R2, MinIO, …).
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=fann-media

# Optional — target an S3-compatible provider instead of AWS.
# Leave S3_ENDPOINT blank for AWS S3. Example for Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS_REGION=auto
#   S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# CDN — base URL for serving media (CloudFront or S3 public URL)
CDN_BASE_URL=https://cdn.fann.guru

# Scheduled work — 'in-process' (default) or 'http'.
#
# 'in-process' keeps the @Cron decorators live, which needs a process that
# stays alive: correct for Docker or any long-running host.
#
# 'http' disables them and expects Vercel Cron (see vercel.json) to POST
# /cron/* on a schedule instead, because serverless functions do not stay
# alive and the decorators would never fire. Set CRON_SECRET too — Vercel
# sends it as `Authorization: Bearer <secret>` and the endpoints reject
# anything else.
SCHEDULER_MODE=in-process
CRON_SECRET=
